  "cards": [
    {
      "dot": "cyan",
      "title": "Single writer",
      "items": [
        "Board is the only SQLite writer; every mutation runs in one immediate transaction",
        "Rules live in board.ts, not in prompts; the viewer opens the file read-only"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Text is redacted before it is stored",
        "Viewer is loopback-only and never selects lease tokens"
      ]
    },
    {
      "dot": "amber",
      "title": "Advice, not control",
      "items": [
        "Hooks send messages to the main session",
        "They never spawn workers or block a tool call"
      ]
    }
  ]
