  "cards": [
    {
      "dot": "rose",
      "title": "Not a vault",
      "items": [
        "Regex catches common shapes, not arbitrary secrets",
        "read, grep, glob and find output is never rewritten"
      ]
    },
    {
      "dot": "cyan",
      "title": "Quiet by design",
      "items": [
        "Only the daily check and /fact-board-update touch the network",
        "The session notice never updates; only /fact-board-update runs git pull --ff-only, and only for git-checkout installs",
        "FACT_BOARD_UPDATE_CHECK=0 turns off the daily check"
      ]
    }
